{
  "name": "@mierkhat/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc",
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "migrate": "tsx src/migrate.ts",
    "local": "tsx scripts/local.ts",
    "typecheck:scripts": "tsc --project tsconfig.scripts.json --noEmit",
    "prebuild": "pnpm --filter @mierkhat/sdk build"
  },
  "dependencies": {
    "@fastify/cors": "11.2.0",
    "@fastify/rate-limit": "10.3.0",
    "@mierkhat/sdk": "workspace:^0.1.0",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "zod": "4.6.7",
    "@stellar/stellar-sdk": "17.4.0"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/pg": "8.15.5",
    "embedded-postgres": "17.6.0-beta.15",
    "tsx": "4.20.6",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mierkhat/backend.git"
  },
  "bugs": {
    "url": "https://github.com/Mierkhat/backend/issues"
  },
  "homepage": "https://github.com/Mierkhat/backend#readme",
  "description": "Durable Stellar testnet preparation, submission and recovery API.",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "24.22.1"
  }
}
