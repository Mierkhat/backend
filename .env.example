DATABASE_URL=postgresql://mierkhat:CHANGE_ME@localhost:5432/mierkhat
# Generate a random encryption key locally: openssl rand -hex 32
PAYLOAD_KEY=
POSTGRES_PASSWORD=
ALLOWED_ORIGINS=http://localhost:5173
TESTNET_RPC_URLS=https://soroban-testnet.stellar.org
PORT=3001
# Optional mode 0600 file containing only the dedicated testnet issuer credentials.
# Required for actual token issuance; never expose through a Vite variable.
TESTNET_FAUCET_KEY_FILE=
# Leave enabled in normal operation. Zero pauses worker sends for maintenance.
WORKERS_ENABLED=1
